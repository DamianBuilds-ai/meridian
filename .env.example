# Meridian Bot Framework - Environment Variable Template
# Copy to .env and fill in your values. Never commit .env to git.
#
# All values shown here are PLACEHOLDERS. Replace with your actual credentials.
# Remove or leave blank any services you are not using - optional keys default to "".

# ============================================================
# LLM PROVIDERS
# ============================================================

# OpenRouter (primary inference provider, multi-model routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=openai/gpt-4o-mini
# Provider order for tool_choice="required" enforcement (verified enforcers only):
OPENROUTER_PROVIDER_ORDER=["together","fireworks","sambanova","cerebras"]

# Mistral (fallback inference provider, optional)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_ID=mistral-small-latest

# Gemini (photo OCR, optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.0-flash

# OpenAI direct (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (voice transcription, optional)
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# TELEGRAM BOT TOKENS
# Get one token per bot from @BotFather on Telegram.
# The suffix after TELEGRAM_BOT_TOKEN_ must match the BOT_NAME env var
# set in docker-compose.yml for that container.
# ============================================================

# Example bots that ship with this repo.
# Replace with your own bot names when you build your fleet.
TELEGRAM_BOT_TOKEN_PIPELINEBOT=your_pipelinebot_token_here
TELEGRAM_BOT_TOKEN_CREATOROPS=your_creatorops_token_here
TELEGRAM_BOT_TOKEN_LIGHTHOUSE=your_lighthouse_token_here
TELEGRAM_BOT_TOKEN_CONTENTPIPELINEBOT=your_contentpipelinebot_token_here
TELEGRAM_BOT_TOKEN_SHIFTBOT=your_shiftbot_token_here
TELEGRAM_BOT_TOKEN_COACHBOT=your_coachbot_token_here
TELEGRAM_BOT_TOKEN_ARIA=your_aria_token_here

# Comma-separated Telegram user IDs allowed to use the bots.
# Leave blank to allow all users (not recommended for production).
ALLOWED_USERS=

# ============================================================
# WEBHOOK
# ============================================================

# Base URL for Telegram webhook mode (e.g. https://api.yourdomain.com/webhook/bots)
WEBHOOK_BASE_URL=https://api.yourdomain.com/webhook/bots

# ============================================================
# TIMEZONE
# ============================================================

# IANA timezone string used for all date/time calculations.
# Examples: "America/New_York", "Europe/London", "Asia/Tokyo", "Australia/Sydney"
# Defaults to "UTC" if not set.
BOT_TIMEZONE=UTC

# ============================================================
# DATABASE
# ============================================================

# SQLite database path used by example bots that persist data locally.
# The default resolves to /app/data/meridian.db inside Docker
# (the named data volume is mounted at /app/data per docker-compose.yml).
MERIDIAN_DB_PATH=./data/meridian.db

# PostgreSQL session store (optional - only needed if you replace the
# default SQLite session backend with PostgreSQL).
# DATABASE_URL=postgresql+asyncpg://botuser:your_password@bot-postgres:5432/botsessions

# Redis (used by session cache and rate limiting)
REDIS_URL=redis://bot-redis:6379/0

# ============================================================
# ARIA BOT - OPTIONAL WEBHOOK
# ============================================================

# Aria can fire an outbound webhook to trigger an external automation
# (e.g. an n8n or Zapier workflow). Leave blank to run in stub/dry-run mode.
# See src/aria/tools/trigger_workflow.py for details.
ARIA_WEBHOOK_URL=
ARIA_WEBHOOK_TIMEOUT=8

# ============================================================
# OBSERVABILITY (Langfuse - optional but recommended)
# Self-hosted: https://langfuse.com/docs/deployment/self-host
# Cloud:       https://cloud.langfuse.com
# ============================================================

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_BASE_URL=http://langfuse-langfuse-web-1:3000

# ============================================================
# SEARCH (optional)
# ============================================================

# SearXNG (self-hosted search engine, runs as a Docker sibling service)
SEARXNG_URL=http://searxng:8080

# ============================================================
# LOCAL INFERENCE (optional)
# ============================================================

# Ollama local model inference.
# Set to http://ollama:11434 and uncomment the ollama service in
# docker-compose.yml to enable. Then set the desired bots to "ollama"
# in BOT_MODEL_MAP in src/config.py.
OLLAMA_URL=

# ============================================================
# TABLE STORE (optional - for bots using shared/tablestore.py)
# ============================================================

# Base URL of your row-based table store instance.
TABLE_STORE_URL=
# API authentication token.
TABLE_STORE_TOKEN=
